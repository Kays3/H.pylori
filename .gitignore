# ---------------------------------------------------------------------------
# Data & sensitive material — NEVER commit
# ---------------------------------------------------------------------------
# Patient-level / cohort data, sequencing outputs
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Tracked on purpose: header-only templates + aggregate meta-analysis inputs
!data/templates/**
!data/meta/**

*.xlsx
*.xls
*.sav
*.dta
*.rds
*.RData
*.feather
*.parquet

# Bibliography source PDFs / manuscripts / correspondence
*.pdf
*.docx
*.doc
*.rtf
*.pptx

# Allow the curated, record-free templates back in
!data/templates/*.csv

# ---------------------------------------------------------------------------
# Generated results
# ---------------------------------------------------------------------------
# Cohort-analysis outputs depend on non-committed patient data -> not tracked.
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep
*.tiff
*.svg

# Meta-analysis outputs are fully reproducible from data/meta/ (small, deterministic)
# -> tracked on purpose. This negation must stay after *.pdf / results/* above.
!results/meta-analysis/**

# ---------------------------------------------------------------------------
# R / RStudio
# ---------------------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
renv/library/
renv/local/
renv/staging/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
